# Marque blanche : commerce actif sur un serveur, bases des autres commerces,
# identifiants FTP par commerce, sauvegardes de base.
.tenant
data/
.env.deploy.*
*.db.bak-*
# Bases des commerces (contenu réel, jamais versionné) et caches locaux.
tenants/*/*.db
tenants/*/*.sqlite
tenants/*/secrets/
.phpunit.result.cache
backups/
# Marqueur d'environnement déposé par le déploiement sur le serveur (preprod|prod).
.app-env
# Sauvegardes automatiques avant édition (fichier.bak-AAAAMMJJ-HHMMSS) : archives locales.
*.bak-*
