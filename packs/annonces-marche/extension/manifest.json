{
  "manifest_version": 3,
  "name": "Synchronisation multi-plateformes",
  "description": "Prépare et publie vos annonces sur les plateformes de seconde main depuis votre navigateur. Outil indépendant, sans affiliation ; publication automatique en opt-in.",
  "version": "1.4.1",
  "key": "",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Synchronisation multi-plateformes",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "sidebar.html"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage", "activeTab", "scripting", "sidePanel", "alarms"],
  "host_permissions": [
    "https://www.leboncoin.fr/*",
    "https://leboncoin.fr/*",
    "https://www.vinted.fr/*",
    "https://vinted.fr/*",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.leboncoin.fr/*", "https://leboncoin.fr/*"],
      "js": ["content/fill.js", "content/leboncoin.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.vinted.fr/*", "https://vinted.fr/*"],
      "js": ["content/fill.js", "content/vinted.js"],
      "run_at": "document_idle"
    }
  ]
}
