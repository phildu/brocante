# Accès de déploiement PRÉPROD — modèle SANS secret (le vrai fichier n'est jamais versionné).
# Copier vers :  .env.deploy.portail          (déploiement --portail, le cas courant)
#                .env.deploy.<commerce>       (un seul commerce)
# puis  chmod 600  sur le fichier copié.
FTP_SERVER=ftp.cluster0XX.hosting.ovh.net
FTP_USER=votre-identifiant-ftp
FTP_PASS=mot-de-passe-ftp
FTP_PATH_FRONT=/www/brocs/
URL_FRONT=https://brocs.arrimage.com

# Mode --portail uniquement : compte de connexion à /portail/ (mot de passe : 10 caractères minimum).
PORTAIL_USER=exploitant
PORTAIL_PASSWORD=mot-de-passe-portail-preprod
