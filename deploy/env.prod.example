# Accès de déploiement PRODUCTION — modèle SANS secret (le vrai fichier n'est jamais versionné).
# Copier vers :  .env.deploy.portail.prod     (déploiement --portail --env prod)
#                .env.deploy.<commerce>.prod  (un seul commerce, --env prod)
# puis  chmod 600  sur le fichier copié.
#
# Règles :
#  - FTP_PATH_FRONT DOIT être un dossier différent de la préprod (le script refuse sinon) ;
#  - mot de passe FTP et PORTAIL_PASSWORD DIFFÉRENTS de la préprod ;
#  - le domaine de URL_FRONT doit pointer sur ce dossier chez OVH (Hébergement → Multisite, SSL activé).
FTP_SERVER=ftp.cluster0XX.hosting.ovh.net
FTP_USER=votre-identifiant-ftp
FTP_PASS=mot-de-passe-ftp-prod
FTP_PATH_FRONT=/www/prod/
URL_FRONT=https://www.votre-domaine.fr

# Mode --portail uniquement : compte de connexion à /portail/ (mot de passe : 10 caractères minimum).
PORTAIL_USER=exploitant
PORTAIL_PASSWORD=mot-de-passe-portail-prod-different
